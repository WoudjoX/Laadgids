# Supabase (leeg laten = lokale seed-data uit /data/seed wordt gebruikt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (leeg laten = leadmails worden gelogd, niet verstuurd)
RESEND_API_KEY=
LEAD_FROM_EMAIL=leads@laadgids.be

# On-demand revalidate: Authorization: Bearer <REVALIDATE_SECRET>
REVALIDATE_SECRET=

# Publieke basis-URL (voor canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optioneel: affiliate-/vergelijkingslink achter de energie-CTA, per land
ENERGY_CTA_URL_BE=
ENERGY_CTA_URL_NL=

# Analytics (een van beide; leeg = niets geladen)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is

# Melding van elke lead naar de eigenaar (leeg = alleen loggen)
LEAD_NOTIFY_EMAIL=
